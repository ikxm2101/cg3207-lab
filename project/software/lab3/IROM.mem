0x000002f0  0x000c2283  lw x5,0(x24)                 279      lw t0, (s8)                     # check if console is ready
0x000002f4  0xfe028ee3  beq x5,x0,0xfffffffc         280      beqz t0, PRINT_INT_WAIT    # Not ready, continue waiting
0x000002f8  0x000f2e03  lw x28,0(x30)                281      lw t3, (t5)                     # load char from memory
0x000002fc  0x01cd2023  sw x28,0(x26)                282      sw t3, (s10)                    # Print char to Console
0x00000300  0xfe5ff0ef  jal x1,0xffffffe4            283      jal PRINT_INT_CONTINUE
0x00000304  0x00002e97  auipc x29,2                  286      la t4, string_2         # Load invalid string
0x00000308  0xd8ce8e93  addi x29,x29,0xfffffd8c           
0x0000030c  0x000ea283  lw x5,0(x29)                 288  	lw t0, (t4)		        # load the word (4 characters) to be displayed
0x00000310  0x00400393  addi x7,x0,4                 289  	li t2, 4		        # byte counter
0x00000314  0x000c2303  lw x6,0(x24)                 291  	lw t1, (s8)		        # check if CONSOLE is ready to send a new character
0x00000318  0xfe030ee3  beq x6,x0,0xfffffffc         292  	beqz t1, NEXT_CHAR_2	# not ready, continue waiting
0x0000031c  0x0162f333  and x6,x5,x22                293  	and t1, t0, s6 		    # apply LSB_MASK
0x00000320  0xce0300e3  beq x6,x0,0xfffffce0         294  	beqz t1, main 	        # null terminator ('\0') detected, done. Return to Programme Start
0x00000324  0x006d2023  sw x6,0(x26)                 295  	sw t1, (s10) 		    # write to UART the Byte(4-t2) of the original word (composed of 4 characters) in (7:0) of the word to be written (remember, we can only write words, and LEDs/UART displays only (7:0) of the written word)
0x00000328  0x0082d293  srli x5,x5,8                 296  	srli t0, t0, 8	 	    # shift so that the next character comes into LSB
0x0000032c  0xfff38393  addi x7,x7,0xffffffff        297  	addi t2, t2, -1		    # decrement the loop counter
0x00000330  0xfe0392e3  bne x7,x0,0xffffffe4         298  	bnez t2, NEXT_CHAR_2	# check and print the next character in the word
0x00000334  0x004e8e93  addi x29,x29,4               299  	addi t4, t4, 4		    # point to next word (4 characters)
0x00000338  0xfd5ff0ef  jal x1,0xffffffd4            300  	jal PRINT_2             # continue printing
